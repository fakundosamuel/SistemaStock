@model IEnumerable<CategoriaVm>
@{
    ViewData["Title"] = "Categorías";
    ViewData["Subtitle"] = "Administración de las categorías de productos";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="bi bi-tags me-1"></i> Listado de categorías</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nueva categoría</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover align-middle datatable w-100">
            <thead>
                <tr>
                    <th>Nombre</th><th>Descripción</th><th>Estado</th>
                    <th class="text-end no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var accion = new AccionesFilaVm(item.Id, $"Categoría '{item.Nombre}' (ID {item.Id})");
                    <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                        <td><partial name="_EstadoBadge" model="item.Activo" /></td>
                        <td>
                            <partial name="_AccionesFila" model="accion" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
