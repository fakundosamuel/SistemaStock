@model MovimientoListaVm
@{
    ViewData["Title"] = "Historial de movimientos";
    ViewData["Subtitle"] = "Entradas, salidas y transferencias ordenadas por fecha";
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label asp-for="Filtro.ProductoId" class="form-label"></label>
                <select asp-for="Filtro.ProductoId" asp-items="Model.Productos" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Filtro.Tipo" class="form-label"></label>
                <select asp-for="Filtro.Tipo" asp-items="Model.Tipos" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Filtrar</button>
                <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover align-middle datatable w-100">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Depósito</th>
                    <th>Tipo</th>
                    <th class="text-end">Cantidad</th>
                    <th>Origen / destino</th>
                    <th>Usuario</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td data-order="@item.Fecha.ToString("yyyyMMddHHmmss")">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Codigo - @item.Producto</td>
                        <td>@item.Deposito</td>
                        <td><span class="badge @item.TipoClase">@item.TipoTexto</span></td>
                        <td class="text-end">@item.Cantidad</td>
                        <td>@item.Contraparte</td>
                        <td>@item.Usuario</td>
                        <td>@item.Observaciones</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
