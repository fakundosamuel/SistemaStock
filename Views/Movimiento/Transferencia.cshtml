@model TransferenciaVm
@{
    ViewData["Title"] = "Registrar transferencia";
    ViewData["Subtitle"] = "Traslado de mercadería entre depósitos";
}

<div class="card">
    <form asp-action="Transferencia" method="post" class="form-operacion">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row">
                <partial name="_CamposComunes" model="Model" />
                <div class="col-md-6 mb-3">
                    <label asp-for="DepositoOrigenId" class="form-label"></label>
                    <select asp-for="DepositoOrigenId" asp-items="Model.Depositos" class="form-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="DepositoOrigenId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DepositoDestinoId" class="form-label"></label>
                    <select asp-for="DepositoDestinoId" asp-items="Model.Depositos" class="form-select">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="DepositoDestinoId" class="text-danger"></span>
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Observaciones" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-warning"><i class="bi bi-truck"></i> Registrar transferencia</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
