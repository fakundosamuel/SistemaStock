@model ProductoVm
@{
    ViewData["Title"] = "Detalle de producto";
    ViewData["Subtitle"] = "Información registrada";
}

<div class="card">
    <div class="card-body">
        <partial name="_Detalle" model="Model" />
    </div>
    <div class="card-footer d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>
</div>
