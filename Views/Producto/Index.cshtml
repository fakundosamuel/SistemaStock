@model IEnumerable<ProductoVm>
@{
    ViewData["Title"] = "Productos";
    ViewData["Subtitle"] = "Administración del catálogo de productos";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="bi bi-box-seam me-1"></i> Listado de productos</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover align-middle datatable w-100">
            <thead>
                <tr>
                    <th>Código</th><th>Nombre</th><th>Categoría</th><th>Marca</th><th>Precio costo</th><th>Precio venta</th><th>Stock mínimo</th><th>Estado</th>
                    <th class="text-end no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var accion = new AccionesFilaVm(item.Id, $"Producto '{item.Nombre}' (ID {item.Id})");
                    <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.CategoriaNombre</td>
                    <td>@item.MarcaNombre</td>
                    <td>@item.PrecioCosto.ToString("C2")</td>
                    <td>@item.PrecioVenta.ToString("C2")</td>
                    <td>@item.StockMinimo</td>
                        <td><partial name="_EstadoBadge" model="item.Activo" /></td>
                        <td>
                            <partial name="_AccionesFila" model="accion" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
