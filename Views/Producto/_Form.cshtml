@model ProductoVm

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Id" />

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="MarcaId" class="form-label"></label>
        <select asp-for="MarcaId" asp-items="Model.Marcas" class="form-select">
            <option value="">-- Sin asignar --</option>
        </select>
        <span asp-validation-for="MarcaId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="UnidadMedidaId" class="form-label"></label>
        <select asp-for="UnidadMedidaId" asp-items="Model.Unidades" class="form-select">
            <option value="">-- Sin asignar --</option>
        </select>
        <span asp-validation-for="UnidadMedidaId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="PrecioCosto" class="form-label"></label>
        <input asp-for="PrecioCosto" class="form-control" />
        <span asp-validation-for="PrecioCosto" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="PrecioVenta" class="form-label"></label>
        <input asp-for="PrecioVenta" class="form-control" />
        <span asp-validation-for="PrecioVenta" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="StockMinimo" class="form-label"></label>
        <input asp-for="StockMinimo" class="form-control" />
        <span asp-validation-for="StockMinimo" class="text-danger"></span>
    </div>
</div>

<div class="form-check form-switch mb-3">
    <input asp-for="Activo" class="form-check-input" />
    <label asp-for="Activo" class="form-check-label"></label>
</div>
