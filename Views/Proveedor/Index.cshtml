@model IEnumerable<ProveedorVm>
@{
    ViewData["Title"] = "Proveedores";
    ViewData["Subtitle"] = "Administración de proveedores";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="bi bi-building me-1"></i> Listado de proveedores</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nuevo proveedor</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover align-middle datatable w-100">
            <thead>
                <tr>
                    <th>Nombre</th><th>Correo electrónico</th><th>Teléfono</th><th>Dirección</th><th>Estado</th>
                    <th class="text-end no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var accion = new AccionesFilaVm(item.Id, $"Proveedor '{item.Nombre}' (ID {item.Id})");
                    <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Email</td>
                    <td>@item.Telefono</td>
                    <td>@item.Direccion</td>
                        <td><partial name="_EstadoBadge" model="item.Activo" /></td>
                        <td>
                            <partial name="_AccionesFila" model="accion" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
