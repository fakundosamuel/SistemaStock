@model AccionesFilaVm
<div class="d-flex justify-content-end gap-1">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-info" title="Detalle">
        <i class="bi bi-eye"></i>
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary" title="Editar">
        <i class="bi bi-pencil"></i>
    </a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-eliminar d-inline"
          data-descripcion="@Model.Descripcion">
        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
            <i class="bi bi-trash"></i>
        </button>
    </form>
</div>
