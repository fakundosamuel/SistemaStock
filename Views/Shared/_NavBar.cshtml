@using System.Security.Claims
@{
    var roles = string.Join(", ", User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value));
}
<nav class="app-header navbar navbar-expand bg-body">
    <div class="container-fluid">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" title="Mostrar u ocultar menú">
                    <i class="bi bi-list"></i>
                </a>
            </li>
        </ul>
        <ul class="navbar-nav ms-auto align-items-center">
            <li class="nav-item d-none d-md-flex align-items-center me-2">
                <i class="bi bi-person-circle me-1"></i>
                <span>@User.Identity?.Name</span>
                @if (!string.IsNullOrEmpty(roles))
                {
                    <span class="badge text-bg-secondary ms-2">@roles</span>
                }
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Cuenta" asp-action="CambiarPassword" title="Cambiar contraseña">
                    <i class="bi bi-key"></i>
                </a>
            </li>
            <li class="nav-item">
                <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm ms-2">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </button>
                </form>
            </li>
        </ul>
    </div>
</nav>
