@model IEnumerable<UnidadMedidaVm>
@{
    ViewData["Title"] = "Unidades de medida";
    ViewData["Subtitle"] = "Administración de las unidades de medida";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="bi bi-rulers me-1"></i> Listado de unidades de medida</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nueva unidad de medida</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover align-middle datatable w-100">
            <thead>
                <tr>
                    <th>Nombre</th><th>Abreviatura</th><th>Estado</th>
                    <th class="text-end no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var accion = new AccionesFilaVm(item.Id, $"Unidad de medida '{item.Nombre}' (ID {item.Id})");
                    <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Abreviatura</td>
                        <td><partial name="_EstadoBadge" model="item.Activo" /></td>
                        <td>
                            <partial name="_AccionesFila" model="accion" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
