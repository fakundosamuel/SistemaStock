@model IEnumerable<UsuarioItemVm>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["Subtitle"] = "Administración de usuarios y roles";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0"><i class="bi bi-person-gear me-1"></i> Listado de usuarios</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Nuevo usuario</a>
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover align-middle datatable w-100">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end no-sort">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Email</td>
                        <td>@item.Rol</td>
                        <td><partial name="_EstadoBadge" model="item.Activo" /></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="ResetPassword" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Restablecer contraseña">
                                <i class="bi bi-key"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
